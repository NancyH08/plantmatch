# Servicios locales incluidos con el proyecto
PRACTICE_STORE_BASE_URL=http://127.0.0.1:8001
REVIEW_API_BASE_URL=http://127.0.0.1:8002
MOCK_API_KEY=plantmatch-demo-key

# Red / reintentos
REQUEST_TIMEOUT_SECONDS=8
MAX_RETRIES=3
BACKOFF_BASE_SECONDS=1

# Streamlit usa el catálogo procesado localmente.
# No subas un archivo .env real a GitHub.
